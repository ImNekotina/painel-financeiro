# ============================================================================
# Painel Financeiro — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA cometa o arquivo ".env" com segredos reais no Git.
# ============================================================================

# URL de conexão do PostgreSQL usada pelo Prisma.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
# Em produção, adicione "?sslmode=require" (ou equivalente do seu provedor)
# para garantir conexão via SSL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/painel_financeiro?schema=public"

# Ambiente de execução. Definido automaticamente pelo Next.js/host em
# produção (não é necessário setar manualmente na maioria dos casos).
# NODE_ENV="production"
